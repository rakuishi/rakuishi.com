---
import type { ImageMetadata } from "astro";

interface Props {
  slug: string;
}

const { slug } = Astro.props;

const modules = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/slides/**/*.webp",
  { eager: true },
);
const images = Object.entries(modules)
  .filter(([path]) => path.includes(`/slides/${slug}/`))
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([, mod]) => mod.default);

if (images.length === 0) {
  throw new Error(`No slide images found in src/assets/slides/${slug}/`);
}

const { width, height } = images[0];
---

<div class="slide-viewer">
  <div class="slide-viewer-frame" style={`aspect-ratio: ${width} / ${height};`}>
    {
      images.map((image, i) => (
        <img
          src={i === 0 ? image.src : undefined}
          data-src={image.src}
          width={image.width}
          height={image.height}
          class:list={["slide-viewer-page", { active: i === 0 }]}
          alt={`Slide page ${i + 1}`}
          decoding="async"
        />
      ))
    }
  </div>
  <div class="slide-viewer-nav">
    <button class="slide-viewer-button prev" aria-label="前のスライド" disabled>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        height="20px"
        viewBox="-244.5 -960 960 960"
        width="20px"
        fill="currentColor"
        aria-hidden="true"
      >
        <path d="M400-80 0-480l400-400 71 71-329 329 329 329-71 71Z"></path>
      </svg>
    </button>
    <span class="slide-viewer-counter">
      <span class="current">1</span> / {images.length}
    </span>
    <button
      class="slide-viewer-button next"
      aria-label="次のスライド"
      disabled={images.length === 1}
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        height="20px"
        viewBox="5.5 -960 960 960"
        width="20px"
        fill="currentColor"
        aria-hidden="true"
      >
        <path d="m321-80-71-71 329-329-329-329 71-71 400 400L321-80Z"></path>
      </svg>
    </button>
  </div>
</div>

<script>
  for (const viewer of document.querySelectorAll(".slide-viewer")) {
    const pages = viewer.querySelectorAll<HTMLImageElement>(".slide-viewer-page");
    const prev = viewer.querySelector<HTMLButtonElement>(".prev")!;
    const next = viewer.querySelector<HTMLButtonElement>(".next")!;
    const counter = viewer.querySelector(".slide-viewer-counter .current")!;
    let current = 0;

    // Inject src only for the current page and its neighbors, so pages load as they are viewed
    const load = (i: number) => {
      const page = pages[i];
      if (page && !page.src) page.src = page.dataset.src!;
    };

    const show = (n: number) => {
      current = Math.max(0, Math.min(n, pages.length - 1));
      load(current - 1);
      load(current);
      load(current + 1);
      pages.forEach((page, i) => page.classList.toggle("active", i === current));
      counter.textContent = String(current + 1);
      prev.disabled = current === 0;
      next.disabled = current === pages.length - 1;
      // Keep the URL shareable without polluting the browser history
      history.replaceState(null, "", `#${current + 1}`);
    };

    load(1);
    const initial = location.hash.match(/^#(\d+)$/);
    if (initial) show(Number(initial[1]) - 1);
    prev.addEventListener("click", () => show(current - 1));
    next.addEventListener("click", () => show(current + 1));
    window.addEventListener("keydown", (e) => {
      // Ignore key presses while the user is typing in a form field
      if (
        e.target instanceof HTMLInputElement ||
        e.target instanceof HTMLTextAreaElement
      ) {
        return;
      }
      if (e.key === "ArrowLeft") show(current - 1);
      if (e.key === "ArrowRight") show(current + 1);
    });
  }
</script>

<style>
  .slide-viewer {
    width: var(--width-slide);
    margin-bottom: 24px;
  }
  .slide-viewer-frame {
    position: relative;
    width: 100%;
    border: 1px solid var(--border-color);
    overflow: hidden;
  }
  .slide-viewer-page {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    visibility: hidden;
    border-radius: 0; /* Cancel the border-radius from .markdown img */
  }
  .slide-viewer-page.active {
    visibility: visible;
  }
  .slide-viewer-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    margin-top: 24px;
  }
  .slide-viewer-button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    padding: 0;
    color: var(--secondary-text-color);
    background-color: var(--primary-background-color);
    border: 2px solid var(--border-color);
    border-radius: 100%;
    cursor: pointer;
  }
  .slide-viewer-button:hover:not(:disabled) {
    background-color: var(--secondary-background-color);
  }
  /* Optical adjustment: nudge each arrow toward the direction it points */
  .slide-viewer-button.prev svg {
    transform: translateX(-2px);
  }
  .slide-viewer-button.next svg {
    transform: translateX(2px);
  }
  .slide-viewer-button:disabled {
    cursor: default;
    opacity: 0.5;
  }
  .slide-viewer-counter {
    min-width: 64px;
    text-align: center;
    color: var(--secondary-text-color);
    font-family: var(--mono-font-family);
    font-size: 14px;
    line-height: 1;
  }
  /* On small screens, stretch the slide to the full viewport width */
  @media (max-width: 768px) {
    .slide-viewer {
      width: 100vw;
    }
    .slide-viewer-frame {
      border-left: none;
      border-right: none;
    }
  }
</style>
